# ─────────────────────────────────────────────────────────────
# Brio — environment
#
# Copy to .env.local. Everything the app needs is here and nothing else:
# these are exactly the variables validated in src/lib/env/server.ts, and the
# app refuses to start if one is missing or malformed — save ANDROID_APP_URL,
# at the end, which only syncing the Android app reads.
#
# There is no database connection string. The app talks to Supabase over its
# API, never to Postgres directly, and schema changes go through the Supabase
# CLI (`supabase db reset` locally, `supabase db push` to a linked project),
# which reads supabase/config.toml and its own link state — not this file.
#
# Two Supabase blocks follow. Exactly one may be uncommented. Local (Docker,
# via the Supabase CLI) is the default; moving to a hosted project later is a
# matter of swapping which block is live — no code changes.
# ─────────────────────────────────────────────────────────────

# ── Supabase: local (Docker) ─────────────────────────────────
# `supabase start` prints these. They are the same for every local Supabase
# project — the well-known demo keys — so they are not secrets.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ── Supabase: cloud (for later) ──────────────────────────────
# Comment out the local block above and fill these in from
# Project Settings → API. The service-role key bypasses row-level security:
# it is a real secret, and must never be committed or sent to the browser.
#
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# SUPABASE_SERVICE_ROLE_KEY=<service role key>

# ── Application ──────────────────────────────────────────────
# Where this app is reachable. The confirmation link in the welcome email is
# built from it, so it has to match the origin the browser is using.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Mail ─────────────────────────────────────────────────────
# Local: Mailpit, shipped with the Supabase CLI. Nothing leaves the machine;
# read what was sent at http://127.0.0.1:54324.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Brio <no-reply@brio.local>"

# Cloud: a Gmail made only for Brio's mail, signed in with an app password
# (docs/RELEASE.md, B3). SMTP_FROM must be that same Gmail address.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=<the Gmail address>
# SMTP_PASSWORD=<the app password, without spaces>
# SMTP_FROM="Brio <the Gmail address>"

# ── Privacy ──────────────────────────────────────────────────
# The address people write to about their account and their data: the
# privacy policy (/privacy) names it. Optional; without it the policy gives
# SMTP_FROM's address, so set it when that is a no-reply one.
SUPPORT_EMAIL=
# SUPPORT_EMAIL=you@example.com

# ── Web push ─────────────────────────────────────────────────
# Order reminders pushed to the installed web app (R8.6). Optional: while any
# of the keys is missing, web push is off and Settings does not offer it.
#
#   npx web-push generate-vapid-keys    the key pair: generate once, and keep it
#                                       (a new pair drops every browser's reminders)
#   openssl rand -hex 32                CRON_SECRET
#
# VAPID_SUBJECT is who the push services may write to; blank means SUPPORT_EMAIL.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
#
# The database's scheduler (0031_web_push.sql) calls the app every five
# minutes. Tell it where, and the secret, once per database — in Supabase's
# SQL editor, or locally with psql — using this app's address and CRON_SECRET:
#
#   select vault.create_secret('https://www.yourdomain.com/api/cron/due-orders', 'due_order_sweep_url');
#   select vault.create_secret('<CRON_SECRET>', 'due_order_sweep_secret');
#
# Locally the database reaches this Mac's dev server at
# http://host.docker.internal:3000/api/cron/due-orders.

# ── Android app ──────────────────────────────────────────────
# Where the Android app loads Brio from (capacitor.config.ts). Read by
# `npm run android:sync`, never by the running web app. A release uses the
# deployed HTTPS address; an emulator reaches this Mac's dev server at
# 10.0.2.2. Plain http is refused for anything but a private address.
ANDROID_APP_URL=http://10.0.2.2:3000
# ANDROID_APP_URL=https://www.yourdomain.com
#
# App Links (R8.5): the SHA-256 fingerprints of the keys the Android app is
# signed with, comma-separated, read by the web app for
# /.well-known/assetlinks.json. Play Console → Test and release → App
# integrity lists both: the app signing key (what Play installs) and the
# upload key (a build installed by hand). Blank, and the email confirmation
# opens in the browser instead of the app.
ANDROID_CERT_FINGERPRINTS=
