{
  "name": "brio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "avatars": "node scripts/avatars.mjs",
    "brand": "node scripts/brand.mjs",
    "splash": "node scripts/splash.mjs",
    "illustrations": "node scripts/illustrations.mjs",
    "plates": "node scripts/plates.mjs",
    "worker": "tsx --env-file-if-exists=.env.local src/worker.ts",
    "pretest": "node scripts/check-test-paths.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "bill-fonts": "node scripts/bill-fonts.mjs",
    "android:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/android-shell.mjs",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/oxide-darwin-arm64": "^4.3.3",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "nodemailer": "^10.0.10",
    "pdfkit": "0.17.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.88.0",
    "sharp": "0.35.4",
    "swr": "^2.5.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^25.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
